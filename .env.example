# OnRecord server config. Copy to .env and edit. All values optional;
# defaults run fully local with SQLite and in-memory fakes where noted.

# Storage. If DATABASE_URL is unset, SQLite is used at DATA_DIR/onrecord.db.
# Postgres example: DATABASE_URL=postgresql://user:pass@localhost:5432/onrecord
DATABASE_URL=
DATA_DIR=./data
CHROMA_DIR=./data/chroma

# Server
# HOST is the bind address. Keep it on localhost, or set it to the
# laptop address on the private hosted network (for example
# 192.168.2.1) so the phone can reach it. The API has no auth, so
# anyone who can reach this port can read transcripts and enroll or
# delete people. Never use 0.0.0.0 on an untrusted network.
HOST=127.0.0.1
PORT=8000

# Identity thresholds (cosine similarity)
FACE_THRESHOLD=0.45
VOICE_THRESHOLD=0.75
FACE_ONLY_THRESHOLD=0.60
VOICE_ONLY_THRESHOLD=0.85

# Speech to text
STT_MODEL=small.en

# Slack digest (optional; digest queues locally when unset)
SLACK_WEBHOOK_URL=

# Rehearsal fixtures are quarantined behind this flag. Never set during judging.
ONRECORD_REHEARSAL=0
